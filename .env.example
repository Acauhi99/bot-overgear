# Get these from https://my.telegram.org/apps after creating an application
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Phone number used to log in (E.164 format, e.g. +5511999999999).
# Required for first-time login (file session) or when running `bot-overgear login`.
TG_PHONE=+55XXXXXXXXXXX

# Optional: 2FA password used silently during first-time login.
# If your account has 2FA and this is unset, you'll be prompted via getpass.
# TG_PASSWORD=your_2fa_password

# Optional: pre-generated StringSession produced by `bot-overgear login`.
# When set, the bot logs in *fully non-interactively* on any machine
# (no .session file needed, no prompts at all). Treat this value like a
# password — anyone with it can fully impersonate your account.
# TG_SESSION_STRING=

# Optional: one-shot login code. Use only in scripted/CI flows; normally
# you just type the code interactively when `bot-overgear login` asks.
# TG_CODE=

# Target bot username (no @)
TARGET_BOT=mythic_queue_bot

# Default time choice when the queue prompts for duration. One of: 30, 60, 90, 120
QUEUE_DURATION_MINUTES=30

# Worker mode: daily local start/stop window.
# START/STOP are local wall-clock times interpreted with WORKER_TZ_OFFSET_HOURS.
# The actual fire time is anchor + a deterministic per-account/per-day offset
# in [0, WORKER_WINDOW_SECONDS), so restarts do not reshuffle today's schedule.
WORKER_START=05:00
WORKER_STOP=23:00
WORKER_WINDOW_SECONDS=300
WORKER_TZ_OFFSET_HOURS=-3

# Path of the Telethon session file (without extension).
# Ignored when TG_SESSION_STRING is set.
SESSION_NAME=bot_overgear

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
